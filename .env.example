# Needed only for `callqa grade`. Every other command runs without it.
ANTHROPIC_API_KEY=

# Optional. The model that grades the calls.
# CALLQA_MODEL=claude-haiku-5-5

# Optional. Which set of calls the commands work on: heldout (the default) or dev.
# CALLQA_SET=heldout

# Optional. Which grading run the dashboard shows, for example clean.haiku-5-5.
# CALLQA_RUN=
